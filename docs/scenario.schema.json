{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Scenarios",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "title",
      "subtitle",
      "steps",
      "phrase",
      "verified"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "title": {
        "type": "string"
      },
      "subtitle": {
        "type": "string"
      },
      "steps": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "text",
            "ref",
            "found"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "ref": {
              "type": "string",
              "description": "Норма закону або \"порада, не норма\""
            },
            "found": {
              "type": "boolean",
              "description": "Норму знайдено в джерелах"
            }
          }
        }
      },
      "phrase": {
        "type": "string",
        "description": "Фраза, яку можна озвучити"
      },
      "verified": {
        "type": "boolean",
        "description": "Перевірено людиною/юристом"
      },
      "last_verified": {
        "type": "string",
        "format": "date"
      },
      "last_checked": {
        "type": "string",
        "format": "date",
        "description": "Коли норми звіряли з джерелами"
      }
    }
  }
}